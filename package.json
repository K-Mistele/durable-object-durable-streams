{
    "name": "@kylelayer/effect-durable-streams-monorepo",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "tools/*"
    ],
    "type": "module",
    "scripts": {
        "check": "vp check && bun run typed:check",
        "typed:check": "tsx tools/typed-lint/src/cli.ts check",
        "test": "vp run -r test",
        "test:conformance": "bun run --cwd packages/cloudflare test:conformance",
        "ready": "bun run check && bun run test && bun run test:conformance",
        "prepare": "effect-tsgo patch --oxlint"
    },
    "dependencies": {
        "effect": "catalog:"
    },
    "devDependencies": {
        "@effect/tsgo": "0.53.1",
        "@effect/vitest": "catalog:",
        "@oxlint/plugins": "1.88.0",
        "@types/node": "^26.1.1",
        "fast-glob": "^3.3.3",
        "oxlint": "1.88.0",
        "oxlint-tsgolint": "7.0.2004",
        "tsx": "^4.23.13",
        "typescript": "7.0.2",
        "typescript-api": "npm:typescript@5.9.3",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "overrides": {
        "vite": "catalog:",
        "vitest": "5.0.4"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "catalog": {
        "@effect/platform-node": "4.0.5",
        "@effect/sql-pglite": "4.0.5",
        "@effect/sql-sqlite-do": "4.0.5",
        "@effect/sql-sqlite-node": "4.0.5",
        "@effect/vitest": "4.0.5",
        "alchemy": "2.0.0-beta.83",
        "effect": "4.0.5",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
        "vite-plus": "1.2.0"
    },
    "patchedDependencies": {
        "@durable-streams/server-conformance-tests@0.3.7": "patches/@durable-streams%2Fserver-conformance-tests@0.3.7.patch"
    }
}
